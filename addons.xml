<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
    <addon id="repository.Abb" name="Abb Repository" version="1.0.0" provider-name="YOS.SOY">
        <requires>
            <import addon="xbmc.addon" version="12.0.0"/>
        </requires>
        <extension point="xbmc.addon.repository" name="Abb Repository">
            <dir>
            <info compressed="false">https://raw.githubusercontent.com/yonni55555/repository.Abb/main/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/yonni55555/repository.Abb/main/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/yonni55555/repository.Abb/main/zips/</datadir>
            </dir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="he">הריפו של Abb</summary>
            <description lang="he">מאגר הרחבות אישי לקודי</description>
            <platform>all</platform>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
            </assets>
        </extension>
    </addon>

    <addon id="plugin.video.seret.top" name="Seret.top" version="1.1.7" provider-name="yonni55555">
        <requires>
            <import addon="xbmc.python" version="3.0.0"/>
            <import addon="script.module.urllib3" version="1.26.11"/>
        </requires>
        <extension point="xbmc.python.video" library="main.py">
            <provides>video</provides>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="he">צפייה בתכני Seret.top</summary>
            <description lang="he">תוסף צפייה ישירה מותאם אישית לקודי</description>
            <platform>all</platform>
        </extension>
    </addon>
</addons>