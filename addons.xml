<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
    <!-- המאגר שלך -->
    <addon id="repository.Abb" name="Abb Repository" version="1.0.0" provider-name="YOS.SOY">
        <requires>
            <import addon="xbmc.addon" version="19.0.0"/>
        </requires>
        <extension point="xbmc.addon.repository" name="Abb Repository">
            <dir>
                <info compressed="false">https://raw.githubusercontent.com/yonni55555/repository.Abb/main/addons.xml</info>
                <checksum>https://raw.githubusercontent.com/yonni55555/repository.Abb/main/addons.xml.md5</checksum>
                <datadir zip="true">https://raw.githubusercontent.com/yonni55555/repository.Abb/main/zips/</datadir>
            </dir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="he">הריפו של Abb</summary>
            <description lang="he">מאגר הרחבות אישי לקודי</description>
            <platform>all</platform>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
            </assets>
        </extension>
    </addon>

    <!-- הרחבת עידן+ פלוס עם השם שלך כמפתח -->
    <addon id="plugin.video.idanplus" name="עידן+ פלוס" version="4.0.4" provider-name="YOS.SOY">
        <requires>
            <import addon="xbmc.addon" version="19.0.0"/>
            <import addon="xbmc.python" version="3.0.1"/>
            <import addon="script.module.requests"/>
            <import addon="script.module.xmltodict"/>
            <import addon="inputstream.adaptive" optional="true"/>
        </requires>
        <extension point="xbmc.python.pluginsource" library="default.py">
            <provides>video</provides>
        </extension>
        <extension point="xbmc.service" library="resources/lib/service.py" start="[login|startup]"/>
        <extension library="resources/" point="xbmc.python.module" />
        <extension library="resources/lib/" point="xbmc.python.module" />
        <extension point="xbmc.addon.metadata">
            <reuselanguageinvoker>true</reuselanguageinvoker>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
            </assets>
            <platform>all</platform>
            <summary lang="he">צפיה בערוצי עידן פלוס ובתכניות מהאתרים הרשמיים.</summary>
            <description lang="he">צפיה בערוצי עידן פלוס ובתכניות מהאתרים הרשמיים.[CR]אפשרויות שונות בהגדרות ההרחבה ובקליק ימני על פריט ברשימה.</description>
            <supportedcontent>
                <content>tvshows</content>
            </supportedcontent>
        </extension>
    </addon>
</addons>
